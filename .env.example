# Copy this file to .env and fill in the values. Never commit .env.
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Supabase secret (service role) key - server-side only.
SUPABASE_SECRET_KEY=
# Phone alerts from the automatic runs (notify.py): a long random ntfy topic name, e.g. fpl-experiment-<random>.
# Leave empty for no alerts.
NTFY_TOPIC=
